      "default": "",
      "maxLength": 300
    },
    {
      "key": "texte_bienvenue",
      "label": "Accueil de la discussion",
      "description": "Accueil (backend).",
      "type": "text",
      "default": "",
      "maxLength": 600
    },
    {
      "key": "suggestions",
      "label": "Suggestions de départ",
      "description": "Suggestions (backend), une par ligne.",
      "type": "text",
      "default": "",
      "maxLength": 1200
