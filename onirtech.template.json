    {
      "key": "lien_footer",
      "label": "Lien du pied de page",
      "description": "Lien pied de page (backend).",
      "type": "url",
      "default": "https://onirtech.com"
    },
    {
      "key": "afficher_credit",
      "label": "Afficher le crédit",
      "description": "Afficher le crédit.",
      "type": "boolean",
      "default": false
