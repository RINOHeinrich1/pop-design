{
  "schemaVersion": 1,
  "kind": "template",
  "id": "pop-design",
  "name": "Pop Design",
  "description": "Template générique : en-tête sur photo, tuiles à fenêtres, galerie et chatbot paramétrable (Markdown, suggestions, pièces jointes, secours).",
  "version": "2.6.2",
  "publisher": {
    "id": "onirtech",
    "name": "ONIRTECH",
    "trustLevel": "official"
  },
  "compatibility": {
    "hostProtocol": "onirtech.template-host.v1"
  },
  "ui": {
    "mode": "web-component",
    "entry": "./dist/index.js",
    "element": "onirtech-template-pop-design",
    "shadowDom": "open",
    "widget": {
      "entry": "./dist/widget.js",
      "element": "onirtech-widget-pop-design",
      "display": {
        "defaultPosition": "bottom-right",
        "allowedPositions": [
          "bottom-right",
          "bottom-left"
        ],
        "closedSize": {
          "width": 64,
          "height": 64
        },
        "openSize": {
          "width": 420,
          "height": 680
        },
        "maxSize": {
          "width": 520,
          "height": 760
        }
      },
      "integrity": "sha256-KqOZc0RyubhjhznSiBqDH/uKXjUfEEgGGElrz+5EdDQ="
    },
    "integrity": "sha256-Ix1DkJiZBp4exrcHv3mj4mesormUcaMm9OrAJ3NMaf8="
  },
  "capabilities": [
    "messages",
    "media",
    "theme",
    "fallback",
    "knowledge",
    "userState"
  ],
  "params": [
    {
      "key": "titre",
      "label": "Titre",
      "description": "Titre de l'en-tête (fourni par le backend/configuration).",
      "type": "string",
      "default": "",
      "maxLength": 60
    },
    {
      "key": "sous_titre",
      "label": "Sous-titre",
      "description": "Phrase d'accueil sous le titre ; {marque} et {lien} remplacés.",
      "type": "text",
      "default": "",
      "maxLength": 300
    },
    {
      "key": "logo_url",
      "label": "Logo",
      "description": "Image du logo (backend/marque).",
      "type": "image",
      "default": ""
    },
    {
      "key": "image_fond",
      "label": "Image de fond",
      "description": "Photo plein écran (backend).",
      "type": "image",
      "default": ""
    },
    {
      "key": "image_soulignement",
      "label": "Soulignement du titre",
      "description": "Trait décoratif (backend).",
      "type": "image",
      "default": ""
    },
    {
      "key": "image_welcome_1",
      "label": "Visuel « Bienvenue » 1",
      "description": "Image panneau (backend).",
      "type": "image",
      "default": ""
    },
    {
      "key": "image_welcome_2",
      "label": "Visuel « Bienvenue » 2",
      "description": "Image panneau (backend).",
      "type": "image",
      "default": ""
    },
    {
      "key": "image_equipe",
      "label": "Portrait d'équipe",
      "description": "Photo panneau équipe (backend).",
      "type": "image",
      "default": ""
    },
    {
      "key": "avatar_assistant_url",
      "label": "Avatar de l'assistant",
      "description": "Avatar assistant (backend).",
      "type": "image",
      "default": ""
    },
    {
      "key": "avatar_utilisateur_url",
      "label": "Avatar du visiteur",
      "description": "Avatar visiteur (backend).",
      "type": "image",
      "default": ""
    },
    {
      "key": "couleur_accent",
      "label": "Couleur d'accent",
      "description": "Accent UI (backend/thème).",
      "type": "color",
      "default": "#006599"
    },
    {
      "key": "couleur_principale",
      "label": "Couleur des cartes",
      "description": "Fond des cartes (backend/thème).",
      "type": "color",
      "default": "#2c2a35"
    },
    {
      "key": "couleur_texte",
      "label": "Couleur du texte",
      "description": "Texte principal (backend/thème).",
      "type": "color",
      "default": "#ffffff"
    },
    {
      "key": "ambiance",
      "label": "Ambiance",
      "description": "Palette générale.",
      "type": "select",
      "default": "pop",
      "options": [
        {
          "value": "pop",
          "label": "Original (photo + cartes sombres)"
        },
        {
          "value": "nuit",
          "label": "Nuit profonde"
        },
        {
          "value": "clair",
          "label": "Clair / papier"
        },
        {
          "value": "sable",
          "label": "Sable chaleureux"
        },
        {
          "value": "ocean",
          "label": "Océan"
        }
      ]
    },
    {
      "key": "densite",
      "label": "Densité",
      "description": "Espacement et taille.",
      "type": "select",
      "default": "confort",
      "options": [
        {
          "value": "confort",
          "label": "Confort"
        },
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ]
    },
    {
      "key": "typographie",
      "label": "Typographie",
      "description": "Famille de police.",
      "type": "select",
      "default": "pop",
      "options": [
        {
          "value": "pop",
          "label": "Originale (sans-serif)"
        },
        {
          "value": "editorial",
          "label": "Éditorial (serif)"
        },
        {
          "value": "technique",
          "label": "Technique (monospace)"
        }
      ]
    },
    {
      "key": "arrondi",
      "label": "Arrondi",
      "description": "Angle des éléments.",
      "type": "select",
      "default": "arrondi",
      "options": [
        {
          "value": "droit",
          "label": "Droit"
        },
        {
          "value": "doux",
          "label": "Doux"
        },
        {
          "value": "arrondi",
          "label": "Arrondi"
        }
      ]
    },
    {
      "key": "titre_welcome",
      "label": "Titre « Bienvenue »",
      "description": "Titre panneau (backend).",
      "type": "string",
      "default": "Bienvenue",
      "maxLength": 60
    },
    {
      "key": "texte_welcome",
      "label": "Texte « Bienvenue »",
      "description": "Contenu panneau (backend).",
      "type": "text",
      "default": "",
      "maxLength": 1200
    },
    {
      "key": "titre_equipe",
      "label": "Titre « Équipe »",
      "description": "Titre panneau (backend).",
      "type": "string",
      "default": "Équipe",
      "maxLength": 60
    },
    {
      "key": "texte_equipe",
      "label": "Texte « Équipe »",
      "description": "Contenu panneau (backend).",
      "type": "text",
      "default": "",
      "maxLength": 1200
    },
    {
      "key": "titre_realisations",
      "label": "Titre « Réalisations »",
      "description": "Titre panneau (backend).",
      "type": "string",
      "default": "Réalisations",
      "maxLength": 60
    },
    {
      "key": "titre_contact",
      "label": "Titre « Contact »",
      "description": "Titre panneau (backend).",
      "type": "string",
      "default": "Contact",
      "maxLength": 60
    },
    {
      "key": "texte_contact",
      "label": "Texte « Contact »",
      "description": "Texte panneau (backend).",
      "type": "text",
      "default": "",
      "maxLength": 600
    },
    {
      "key": "titre_identite",
      "label": "Titre du formulaire",
      "description": "Titre formulaire (backend).",
      "type": "string",
      "default": "",
      "maxLength": 80
    },
    {
      "key": "texte_identite",
